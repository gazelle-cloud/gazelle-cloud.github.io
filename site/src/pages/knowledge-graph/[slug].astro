---
import GraphPage from '../../layouts/GraphPage.astro';

export async function getStaticPaths() {
  const { DATA_REPO, BASE_PATH } = await import('../../data');

  const token = import.meta.env.GITHUB_TOKEN;
  const headers: Record<string, string> = {
    Accept: 'application/vnd.github+json',
    ...(token ? { Authorization: `Bearer ${token}` } : {}),
  };

  async function fetchCategory(category: string, type: string): Promise<any[]> {
    const res = await fetch(`https://api.github.com/repos/${DATA_REPO}/contents/${BASE_PATH}/${category}`, { headers });
    const listing: any[] = await res.json();
    if (!Array.isArray(listing)) return [];
    return Promise.all(
      listing
        .filter((f: any) => f.type === 'file' && f.name.endsWith('.json'))
        .map((f: any) => fetch(f.download_url, { headers }).then(r => r.json()).then((obj: any) => ({ ...obj, type })))
    );
  }

  const [foundations, constitutive, regEntity, regProcess] = await Promise.all([
    fetchCategory('foundations', 'foundation'),
    fetchCategory('constitutive', 'constitutive'),
    fetchCategory('regulative-entity', 'regulative'),
    fetchCategory('regulative-process', 'regulative'),
  ]);
  const nodes = [...foundations, ...constitutive, ...regEntity, ...regProcess];
  return nodes.map((n: any) => ({
    params: { slug: n.id },
    props:  { node: n },
  }));
}

const { node } = Astro.props as { node: any };
const name  = node.id;
const label = node.label || name.replace(/-/g, ' ').replace(/\b\w/g, (c: string) => c.toUpperCase());
const desc  = (node.intent || node.rule || node.decision || node.why || '').slice(0, 155);
---
<GraphPage title={label} description={desc || undefined} page="/knowledge-graph.page.js">
  <script is:inline define:vars={{ name }}>
    history.replaceState(null, '', '#' + name);
  </script>

  <div class="sr-only">
    <h1>{name}</h1>
    <p>Type: {node.type}</p>

    {node.intent && (
      <>
        <h2>Intent</h2>
        <p>{node.intent}</p>
      </>
    )}

    {node.rule && (
      <>
        <h2>Rule</h2>
        <p>{node.rule}</p>
      </>
    )}

    {node.decision && (
      <>
        <h2>Decision</h2>
        <p>{node.decision}</p>
      </>
    )}

    {node.why && (
      <>
        <h2>Why</h2>
        <p>{node.why}</p>
      </>
    )}

    {node.violations?.length > 0 && (
      <>
        <h2>Violations</h2>
        <ul>
          {node.violations.map((v: string) => (
            <li>{v}</li>
          ))}
        </ul>
      </>
    )}

    {node.anchor && (
      <>
        <h2>Anchor</h2>
        <p><a href={`/knowledge-graph/${node.anchor}/`}>{node.anchor}</a></p>
      </>
    )}

    {node.implements?.length > 0 && (
      <>
        <h2>Implements</h2>
        <ul>
          {[].concat(node.implements).map((id: string) => (
            <li><a href={`/knowledge-graph/${id}/`}>{id}</a></li>
          ))}
        </ul>
      </>
    )}

    {node.steps?.length > 0 && (
      <>
        <h2>Steps</h2>
        <ol>
          {node.steps.map((s: string) => (
            <li>{s}</li>
          ))}
        </ol>
      </>
    )}

    {node.files?.length > 0 && (
      <>
        <h2>Files</h2>
        <ul>
          {node.files.map((f: string) => (
            <li>{f}</li>
          ))}
        </ul>
      </>
    )}

    {node.links?.length > 0 && (
      <>
        <h2>Links</h2>
        <ul>
          {node.links.map((l: any) => (
            <li>
              <a href={`/knowledge-graph/${l.target}/`}>{l.target}</a>
              {l.relation && <span> ({l.relation})</span>}
              {l.note && <span> — {l.note}</span>}
            </li>
          ))}
        </ul>
      </>
    )}

    <p><a href="/knowledge-graph/">← Back to knowledge graph</a></p>
  </div>
</GraphPage>
